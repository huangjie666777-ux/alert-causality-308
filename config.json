{
  "host": "127.0.0.1",
  "port": 8080,
  "sqlite_path": "data/alerts.db",
  "targets": [
    {
      "id": "demo-exporter",
      "url": "http://127.0.0.1:9101/metrics",
      "interval_seconds": 1,
      "timeout_seconds": 2,
      "max_response_bytes": 1048576
    }
  ],
  "rules": [
    {
      "id": "demo-temperature-high",
      "target_id": "demo-exporter",
      "metric": "demo_temperature_celsius",
      "labels": {"room": "server"},
      "threshold": 30,
      "duration_seconds": 3
    },
    {
      "id": "demo-humidity-high",
      "target_id": "demo-exporter",
      "metric": "demo_humidity_percent",
      "labels": {"room": "server"},
      "threshold": 60,
      "duration_seconds": 3,
      "depends_on": [
        {"rule_id": "demo-temperature-high", "labels": ["room"]}
      ]
    }
  ]
}
